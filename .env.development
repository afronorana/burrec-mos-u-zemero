# Local Nakama (nakama/docker-compose.yml). Key must match socket.server_key in nakama/local.yml.
VITE_NAKAMA_HOST=127.0.0.1
VITE_NAKAMA_PORT=7350
VITE_NAKAMA_SSL=false
VITE_NAKAMA_KEY=burrec-dev-key
# OAuth sign-in buttons appear only when these are set.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
