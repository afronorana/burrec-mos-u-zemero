{
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2015"],
    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "typeRoots": ["./node_modules"],
    "types": ["nakama-runtime"]
  },
  "include": ["src/**/*.ts", "../shared/protocol.js"]
}
