# Production Nakama behind Caddy TLS (nakama/docker-compose.prod.yml).
# Vite bakes these at build time: any change here requires rebuilding docs/ (pnpm build).
# Set the real domain + key before deploying; key must match NAKAMA_SERVER_KEY on the droplet.
VITE_NAKAMA_HOST=nakama.example.com
VITE_NAKAMA_PORT=443
VITE_NAKAMA_SSL=true
VITE_NAKAMA_KEY=change-me-prod-server-key
